# Telegram
TELEGRAM_BOT_TOKEN=
# Необязательно, иначе берётся из getMe
BOT_USERNAME=
# Пусто = регистрация открыта всем. Иначе список через запятую: 111,222
ALLOWED_TELEGRAM_IDS=
# Необязательно: свой адрес Bot API (зеркало/прокси). Для HTTP-прокси используйте HTTPS_PROXY
TELEGRAM_API_URL=

# Публичный адрес панели (для ссылок входа)
PUBLIC_URL=http://localhost:3000
# magic_link | none
PANEL_AUTH_MODE=magic_link
# Для режима none (пусто = единственная существующая семья)
PANEL_FAMILY_ID=

# LLM основной (любой OpenAI-совместимый провайдер)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openrouter/free
LLM_TIMEOUT=15s
LLM_MAX_OUTPUT_TOKENS=200
LLM_MAX_CONCURRENCY=4
# Для «думающих» моделей (Gemini 3.x, gpt-5): none | minimal | low. Пусто - не передаётся
LLM_REASONING_EFFORT=

# LLM запасной (опционально, задаётся целиком)
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_REASONING_EFFORT=

# tools | json
AGENT_MODE=tools

# Лимиты и квоты
RATE_LIMIT_PER_MIN=10
LLM_DAILY_QUOTA_USER=100
LLM_DAILY_QUOTA_FAMILY=400
# Общий суточный предохранитель на все семьи, 0 = без лимита
LLM_DAILY_QUOTA_GLOBAL=5000
MAX_MESSAGE_LEN=300
MAX_FAMILY_MEMBERS=10
INVITE_TTL=168h
INVITE_MAX_USES=10

# Словарь синонимов и онлайн-тезаурус (Викисловарь) для незнакомых слов.
# Онлайн уходит только одно незнакомое слово, результат кэшируется в БД.
SYNONYMS_PATH=config/synonyms.yaml
THESAURUS_ENABLED=true
THESAURUS_URL=https://ru.wiktionary.org/w/api.php
THESAURUS_TIMEOUT=3s

# Время и деньги
APP_TZ=Europe/Moscow
CURRENCY=RUB

# БД и сервер. Для локального go run вместо db укажите localhost
DB_DSN=postgres://app:app@db:5432/expenses?sslmode=disable
# Порт Postgres на хосте для make run (если 5432 занят локальным Postgres - поменяйте)
DB_HOST_PORT=5432
HTTP_ADDR=:8080
# debug | info | warn | error
LOG_LEVEL=info
